# Supabase — publicos, vao ao cliente
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — IGNORA RLS. So servidor: seed e backfill.
# Nunca em Client Component, nunca com prefixo NEXT_PUBLIC_, nunca em commit.
SUPABASE_SERVICE_ROLE_KEY=

# TMDb — token de leitura v4. So servidor.
# themoviedb.org > Settings > API > API Read Access Token
TMDB_READ_TOKEN=
